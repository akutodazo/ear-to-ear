{
  "permissions": {
    "deny": [
      "Read(./.dev.vars)",
      "Read(./.env*)",
      "Read(./private/**)",
      "Bash(git push * main*)",
      "PowerShell(git push * main*)",
      "Bash(npx wrangler *secret put*)",
      "PowerShell(npx wrangler *secret put*)",
      "Bash(npx wrangler *secret delete*)",
      "PowerShell(npx wrangler *secret delete*)",
      "Bash(npx wrangler *secret bulk*)",
      "PowerShell(npx wrangler *secret bulk*)",
      "Bash(npx wrangler *versions secret*)",
      "PowerShell(npx wrangler *versions secret*)",
      "Bash(npx wrangler *d1 execute*--remote*)",
      "PowerShell(npx wrangler *d1 execute*--remote*)",
      "Bash(npx wrangler *d1 create*)",
      "PowerShell(npx wrangler *d1 create*)",
      "Bash(npx wrangler *d1 delete*)",
      "PowerShell(npx wrangler *d1 delete*)",
      "Bash(npx wrangler *d1 time-travel*)",
      "PowerShell(npx wrangler *d1 time-travel*)",
      "Bash(npx wrangler *r2 object put*)",
      "PowerShell(npx wrangler *r2 object put*)",
      "Bash(npx wrangler *r2 object delete*)",
      "PowerShell(npx wrangler *r2 object delete*)",
      "Bash(npx wrangler *r2 bucket*)",
      "PowerShell(npx wrangler *r2 bucket*)",
      "Bash(npx wrangler *delete*)",
      "PowerShell(npx wrangler *delete*)",
      "Bash(npx wrangler *login*)",
      "PowerShell(npx wrangler *login*)",
      "Bash(npx --yes wrangler*)",
      "PowerShell(npx --yes wrangler*)",
      "Bash(npx -y wrangler*)",
      "PowerShell(npx -y wrangler*)",
      "Bash(npx wrangler@*)",
      "PowerShell(npx wrangler@*)",
      "Bash(npm exec*wrangler*)",
      "PowerShell(npm exec*wrangler*)",
      "Bash(*node_modules*wrangler*)",
      "PowerShell(*node_modules*wrangler*)",
      "Bash(node *l6-live*)",
      "PowerShell(node *l6-live*)",
      "Bash(env)",
      "Bash(env *)",
      "Bash(printenv*)",
      "Bash(set)",
      "Bash(export -p*)",
      "PowerShell(Get-ChildItem Env:*)",
      "PowerShell(Get-ChildItem env:*)",
      "PowerShell(gci env:*)",
      "PowerShell(gci Env:*)",
      "PowerShell(dir env:*)",
      "PowerShell(dir Env:*)",
      "PowerShell(ls env:*)",
      "PowerShell(ls Env:*)",
      "PowerShell(Get-Item Env:*)",
      "PowerShell(Get-Item env:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/ask-before-edit.mjs\""
          }
        ]
      }
    ]
  }
}
